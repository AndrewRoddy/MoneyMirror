@page "/human-capital"
@rendermode InteractiveServer
@using Microsoft.Extensions.Options
@using MoneyMirror.HumanCapital
@inject IResumeUploadValidator UploadValidator
@inject IResumeTextExtractionService TextExtractionService
@inject IProfessionalProfileExtractionService ProfileExtractionService
@inject IProfessionalProfileRepository ProfileRepository
@inject IOptions<ResumeUploadOptions> UploadOptions
@inject NavigationManager Navigation

<PageTitle>Human Capital</PageTitle>

<div class="standard-page">
    <header class="page-header">
        <div>
            <h1>Human Capital</h1>
            <p class="page-subtitle">Upload a resume to estimate your Market Potential.</p>
        </div>
    </header>

    <section class="page-card">
        <h2 class="page-section-title">Resume</h2>
        <p class="text-muted">PDF and DOCX files are supported. Your resume is used to build an editable professional profile.</p>
        <InputFile OnChange="OnFileSelectedAsync" accept=".pdf,.docx" disabled="@_isProcessing" />
    </section>

@if (_isProcessing)
{
    <div class="alert alert-info" role="status" aria-live="polite">
        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
        <em>@_processingMessage</em>
    </div>
}

@if (_errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}

@if (_profile is not null)
{
    <section class="page-card">
        <h2 class="page-section-title">Review Extracted Profile</h2>
        <p>Fix anything the extraction got wrong, then save your corrections.</p>

    @if (_savedMessage is not null)
    {
        <div class="alert alert-success" role="alert">@_savedMessage</div>
    }

    <EditableSection Title="Education" TItem="EditableEducation" Items="_education">
        <ItemTemplate Context="item">
            <div class="row g-2">
                <div class="col"><input class="form-control form-control-sm" placeholder="Institution" @bind="item.Institution" /></div>
                <div class="col"><input class="form-control form-control-sm" placeholder="Degree" @bind="item.Degree" /></div>
                <div class="col"><input class="form-control form-control-sm" placeholder="Field of study" @bind="item.FieldOfStudy" /></div>
                <div class="col"><input class="form-control form-control-sm" placeholder="Start" @bind="item.StartDate" /></div>
                <div class="col"><input class="form-control form-control-sm" placeholder="End" @bind="item.EndDate" /></div>
            </div>
        </ItemTemplate>
    </EditableSection>

    <EditableSection Title="Experience" TItem="EditableExperience" Items="_experience">
        <ItemTemplate Context="item">
            <div class="row g-2">
                <div class="col"><input class="form-control form-control-sm" placeholder="Organization" @bind="item.Organization" /></div>
                <div class="col"><input class="form-control form-control-sm" placeholder="Title" @bind="item.Title" /></div>
                <div class="col"><input class="form-control form-control-sm" placeholder="Start" @bind="item.StartDate" /></div>
                <div class="col"><input class="form-control form-control-sm" placeholder="End" @bind="item.EndDate" /></div>
                <div class="col"><input class="form-control form-control-sm" placeholder="Description" @bind="item.Description" /></div>
            </div>
        </ItemTemplate>
    </EditableSection>

    <EditableSection Title="Certifications" TItem="EditableCertification" Items="_certifications">
        <ItemTemplate Context="item">
            <div class="row g-2">
                <div class="col"><input class="form-control form-control-sm" placeholder="Name" @bind="item.Name" /></div>
                <div class="col"><input class="form-control form-control-sm" placeholder="Issuing organization" @bind="item.IssuingOrganization" /></div>
                <div class="col"><input class="form-control form-control-sm" placeholder="Issue date" @bind="item.IssueDate" /></div>
            </div>
        </ItemTemplate>
    </EditableSection>

    <EditableSection Title="Skills" TItem="EditableSkill" Items="_skills">
        <ItemTemplate Context="item">
            <div class="row g-2">
                <div class="col"><input class="form-control form-control-sm" placeholder="Skill" @bind="item.Name" /></div>
                <div class="col"><input class="form-control form-control-sm" placeholder="Category" @bind="item.Category" /></div>
            </div>
        </ItemTemplate>
    </EditableSection>

    <EditableSection Title="Projects" TItem="EditableProject" Items="_projects">
        <ItemTemplate Context="item">
            <div class="row g-2">
                <div class="col"><input class="form-control form-control-sm" placeholder="Name" @bind="item.Name" /></div>
                <div class="col"><input class="form-control form-control-sm" placeholder="Description" @bind="item.Description" /></div>
            </div>
        </ItemTemplate>
    </EditableSection>

    <ProfileSection Title="Publications" IsEmpty="@(_profile.Publications.Count == 0)">
        <ul>
            @foreach (var item in _profile.Publications)
            {
                <li>@item.Title @(item.Venue is not null ? $" — {item.Venue}" : "")</li>
            }
        </ul>
    </ProfileSection>

    <ProfileSection Title="Awards" IsEmpty="@(_profile.Awards.Count == 0)">
        <ul>
            @foreach (var item in _profile.Awards)
            {
                <li>@item.Name @(item.IssuingOrganization is not null ? $" — {item.IssuingOrganization}" : "")</li>
            }
        </ul>
    </ProfileSection>

    <button type="button" class="btn btn-primary mt-2" @onclick="SaveCorrectionsAsync" disabled="@_isSaving">
        @(_isSaving ? "Saving..." : "Save Corrections")
    </button>
    </section>
}
</div>

@code {
    private bool _isProcessing;
    private bool _isSaving;
    private string? _processingMessage;
    private string? _errorMessage;
    private string? _savedMessage;
    private string? _fileName;
    private ProfessionalProfile? _profile;

    private List<EditableEducation> _education = [];
    private List<EditableExperience> _experience = [];
    private List<EditableCertification> _certifications = [];
    private List<EditableSkill> _skills = [];
    private List<EditableProject> _projects = [];

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _errorMessage = null;
        _savedMessage = null;
        _profile = null;
        _processingMessage = null;

        var file = e.File;
        _fileName = file.Name;

        var validation = UploadValidator.Validate(file.Name, file.Size);
        if (!validation.IsValid)
        {
            _errorMessage = validation.Error;
            return;
        }

        _isProcessing = true;
        _processingMessage = "Reading the uploaded resume...";
        StateHasChanged();

        try
        {
            await using var stream = file.OpenReadStream(UploadOptions.Value.MaxFileSizeBytes);
            var text = await TextExtractionService.ExtractTextAsync(stream, file.Name);
            _processingMessage = "Extracting your professional profile with AI...";
            StateHasChanged();
            _profile = await ProfileExtractionService.ExtractAsync(text);
            LoadEditableLists(_profile);
        }
        catch (ResumeTextExtractionException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (ProfileExtractionException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isProcessing = false;
            _processingMessage = null;
        }
    }

    private void LoadEditableLists(ProfessionalProfile profile)
    {
        _education = profile.Education.Select(EditableEducation.From).ToList();
        _experience = profile.Experience.Select(EditableExperience.From).ToList();
        _certifications = profile.Certifications.Select(EditableCertification.From).ToList();
        _skills = profile.Skills.Select(EditableSkill.From).ToList();
        _projects = profile.Projects.Select(EditableProject.From).ToList();
    }

    /// <summary>
    /// Rebuilds _profile from the edited lists and persists it to the
    /// default profile via IProfessionalProfileRepository (#89).
    /// </summary>
    private async Task SaveCorrectionsAsync()
    {
        if (_profile is null)
        {
            return;
        }

        _profile = _profile with
        {
            Education = _education.Select(e => e.ToRecord()).ToList(),
            Experience = _experience.Select(e => e.ToRecord()).ToList(),
            Certifications = _certifications.Select(e => e.ToRecord()).ToList(),
            Skills = _skills.Select(e => e.ToRecord()).ToList(),
            Projects = _projects.Select(e => e.ToRecord()).ToList(),
        };

        _errorMessage = null;
        _savedMessage = null;
        _isSaving = true;
        StateHasChanged();

        try
        {
            await ProfileRepository.SaveAsync(_profile);
            _savedMessage = "Corrections saved. Taking you to your Market Potential...";
            _isSaving = false;
            StateHasChanged();

            // #113: carry the user straight through to occupation matching /
            // Market Potential rather than requiring manual navigation - the
            // brief pause just lets them see the confirmation above first.
            await Task.Delay(TimeSpan.FromSeconds(1.5));
            Navigation.NavigateTo("/market-potential");
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to save corrections: {ex.Message}";
            _isSaving = false;
        }
    }

    private class EditableEducation
    {
        public string Institution { get; set; } = string.Empty;
        public string Degree { get; set; } = string.Empty;
        public string FieldOfStudy { get; set; } = string.Empty;
        public string StartDate { get; set; } = string.Empty;
        public string EndDate { get; set; } = string.Empty;

        public static EditableEducation From(EducationRecord r) =>
            new()
            {
                Institution = r.Institution,
                Degree = r.Degree ?? string.Empty,
                FieldOfStudy = r.FieldOfStudy ?? string.Empty,
                StartDate = r.StartDate ?? string.Empty,
                EndDate = r.EndDate ?? string.Empty,
            };

        public EducationRecord ToRecord() =>
            new(Institution, NullIfBlank(Degree), NullIfBlank(FieldOfStudy), NullIfBlank(StartDate), NullIfBlank(EndDate));
    }

    private class EditableExperience
    {
        public string Organization { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string StartDate { get; set; } = string.Empty;
        public string EndDate { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;

        public static EditableExperience From(Experience r) =>
            new()
            {
                Organization = r.Organization,
                Title = r.Title ?? string.Empty,
                StartDate = r.StartDate ?? string.Empty,
                EndDate = r.EndDate ?? string.Empty,
                Description = r.Description ?? string.Empty,
            };

        public Experience ToRecord() =>
            new(Organization, NullIfBlank(Title), NullIfBlank(StartDate), NullIfBlank(EndDate), NullIfBlank(Description));
    }

    private class EditableCertification
    {
        public string Name { get; set; } = string.Empty;
        public string IssuingOrganization { get; set; } = string.Empty;
        public string IssueDate { get; set; } = string.Empty;

        public static EditableCertification From(Certification r) =>
            new()
            {
                Name = r.Name,
                IssuingOrganization = r.IssuingOrganization ?? string.Empty,
                IssueDate = r.IssueDate ?? string.Empty,
            };

        public Certification ToRecord() => new(Name, NullIfBlank(IssuingOrganization), NullIfBlank(IssueDate));
    }

    private class EditableSkill
    {
        public string Name { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;

        public static EditableSkill From(Skill r) => new() { Name = r.Name, Category = r.Category ?? string.Empty };

        public Skill ToRecord() => new(Name, NullIfBlank(Category));
    }

    private class EditableProject
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;

        public static EditableProject From(Project r) => new() { Name = r.Name, Description = r.Description ?? string.Empty };

        public Project ToRecord() => new(Name, NullIfBlank(Description));
    }

    private static string? NullIfBlank(string value) => string.IsNullOrWhiteSpace(value) ? null : value;
}

