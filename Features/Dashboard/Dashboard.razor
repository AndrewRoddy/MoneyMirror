@page "/"

<PageTitle>Dashboard</PageTitle>

<h1>Dashboard</h1>

<p>Net worth summary and Market Potential will appear here.</p>

<div class="row mt-4">
    <div class="col-md-6 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Scan a Possession</h5>
                <p class="card-text">
                    Photograph something you own to detect, identify, and value it.
                </p>
                <a href="physical-assets" class="btn btn-primary">Scan a Possession</a>
            </div>
        </div>
    </div>

    <div class="col-md-6 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Upload a Resume</h5>
                <p class="card-text">
                    Upload your resume to see your estimated Market Potential.
                </p>
                <a href="human-capital" class="btn btn-primary">Upload a Resume</a>
            </div>
        </div>
    </div>
</div>
