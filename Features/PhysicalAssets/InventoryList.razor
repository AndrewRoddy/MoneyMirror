@using MoneyMirror.PhysicalAssets
@inject IPhysicalAssetRepository AssetRepository
@inject IAssetValuationService ValuationService

@if (_errorMessage is not null)
{
    <ErrorAlert Message="@_errorMessage" RawResponse="@_errorRawResponse" />
}

@if (_assets is null)
{
    <p class="ledger-loading"><em>Loading...</em></p>
}
else
{
    <div class="ledger-total-card">
        <p class="ledger-total-label">Total value</p>
        <div class="ledger-total-figure">
            $@_assets.Sum(a => a.CurrentValuation ?? 0).ToString("N2")<small>USD</small>
        </div>
        <div class="ledger-total-foot">
            <span>@_assets.Count @(_assets.Count == 1 ? "item" : "items") scanned</span>
            @if (_assets.Any(a => a.CurrentValuation is null))
            {
                <span class="ledger-total-pill">some unvalued</span>
            }
        </div>
    </div>

    @if (_assets.Count == 0)
    {
        <div class="ledger-empty">
            <span class="ledger-icon-badge ledger-icon-badge-lg">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 8l-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/></svg>
            </span>
            <p><em>No items yet. Add one below, or scan a possession.</em></p>
        </div>
    }
    else
    {
        <ul class="asset-list">
            @foreach (var asset in _assets)
            {
                <li class="asset-row">
                    @if (_editingId == asset.Id)
                    {
                        <div class="asset-edit-form">
                            <input class="form-control form-control-sm" placeholder="Name" @bind="_editName" />
                            <input class="form-control form-control-sm" placeholder="Category" @bind="_editCategory" />
                            <input class="form-control form-control-sm" placeholder="Product/Model" @bind="_editModel" />
                            <input
                                class="form-control form-control-sm"
                                type="number"
                                step="0.01"
                                placeholder="New valuation (optional)"
                                @bind="_editValuation" />
                            <div class="asset-row-actions">
                                <button class="btn btn-sm btn-primary" @onclick="SaveEditAsync">Save</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">Cancel</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button
                            type="button"
                            class="asset-row-summary"
                            aria-expanded="@(_expandedId == asset.Id)"
                            @onclick="() => ToggleExpandAsync(asset.Id)">
                            <span class="ledger-icon-badge">@CategoryIconMarkup(asset.Category)</span>
                            <span class="asset-row-main">
                                <span class="asset-row-name">@asset.Name</span>
                                <span class="asset-row-meta">
                                    @(string.IsNullOrWhiteSpace(asset.Category)
                                        ? (asset.IsManuallyAdded ? "Manual" : "Scanned")
                                        : $"{asset.Category} \u00b7 {(asset.IsManuallyAdded ? "Manual" : "Scanned")}")
                                </span>
                            </span>
                            <span class="asset-row-value">@(asset.CurrentValuation is { } v ? $"${v:N2}" : "—")</span>
                            <span class="asset-row-caret" aria-hidden="true"></span>
                        </button>

                        @if (_expandedId == asset.Id)
                        {
                            <div class="asset-row-detail">
                                @if (_detailError is not null)
                                {
                                    <div class="alert alert-danger" role="alert">@_detailError</div>
                                }
                                else if (_detail is null)
                                {
                                    <p><em>Loading details...</em></p>
                                }
                                else
                                {
                                    @if (_detail.ImageReference is not null)
                                    {
                                        <img
                                            src="@($"/api/possession-images/{_detail.ImageReference}")"
                                            alt="@_detail.Name"
                                            class="asset-detail-image" />
                                    }

                                    <dl class="asset-detail-facts">
                                        <dt>Product/Model</dt>
                                        <dd>@(_detail.IdentifiedProductModel ?? "—")</dd>
                                    </dl>

                                    <div class="ledger-detail-actions">
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => BeginEdit(asset)">Edit</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(asset.Id)">Delete</button>
                                        <button
                                            class="btn btn-sm btn-outline-primary"
                                            disabled="@_isRevaluing"
                                            @onclick="RevalueAsync">
                                            @(_isRevaluing ? "Revaluing..." : "Revalue")
                                        </button>
                                    </div>
                                    @if (_revalueError is not null)
                                    {
                                        <div class="mt-2">
                                            <ErrorAlert Message="@_revalueError" RawResponse="@_revalueRawResponse" />
                                        </div>
                                    }

                                    <h3 class="ledger-subheading">Valuation History</h3>
                                    @if (_detail.ValuationHistory.Count == 0)
                                    {
                                        <p><em>No valuations yet.</em></p>
                                    }
                                    else
                                    {
                                        <ul class="list-unstyled">
                                            @foreach (var entry in _detail.ValuationHistory)
                                            {
                                                <li class="border rounded p-3 mb-2">
                                                    <span class="fw-bold">$@entry.EstimatedValue.ToString("N2")</span>
                                                    <span class="text-muted">on @entry.ValuedAt.ToString("d")</span>
                                                    @if (entry.Source is not null)
                                                    {
                                                        <span class="badge bg-secondary">@entry.Source</span>
                                                    }
                                                    @if (entry.Notes is not null)
                                                    {
                                                        <p class="mb-0 mt-1">@entry.Notes</p>
                                                    }
                                                    @if (entry.ComparableListings.Count > 0)
                                                    {
                                                        <ul class="list-unstyled mt-2 mb-0 ps-3 small">
                                                            @foreach (var listing in entry.ComparableListings)
                                                            {
                                                                <li>
                                                                    $@listing.PriceUsd.ToString("N2") &mdash; @listing.Source
                                                                    @if (listing.ListingTitle is not null)
                                                                    {
                                                                        <text>: @listing.ListingTitle</text>
                                                                    }
                                                                    @if (listing.Condition is not null)
                                                                    {
                                                                        <span class="text-muted"> (@listing.Condition)</span>
                                                                    }
                                                                </li>
                                                            }
                                                        </ul>
                                                    }
                                                </li>
                                            }
                                        </ul>
                                    }
                                }
                            </div>
                        }
                    }
                </li>
            }
        </ul>
    }
}

@if (ShowAddForm)
{
    <div id="add-item" class="ledger-add-card">
        <h2 class="ledger-subheading">Add item</h2>
        <p class="ledger-hint">Its value is estimated automatically, the same way a scanned possession's is.</p>
        <div class="ledger-add-grid">
            <input class="form-control" placeholder="Name" @bind="_newName" />
            <input class="form-control" placeholder="Category" @bind="_newCategory" />
            <input class="form-control" placeholder="Product/Model" @bind="_newModel" />
            <button class="btn btn-primary" @onclick="AddAsync" disabled="@(string.IsNullOrWhiteSpace(_newName) || _isAdding)">
                @(_isAdding ? "Estimating value..." : "Add")
            </button>
        </div>
    </div>
}

@code {
    [Parameter]
    public bool ShowAddForm { get; set; } = true;

    private List<PhysicalAssetSummary>? _assets;
    private string? _errorMessage;
    private string? _errorRawResponse;

    private string _newName = string.Empty;
    private string? _newCategory;
    private string? _newModel;
    private bool _isAdding;

    private Guid? _editingId;
    private string _editName = string.Empty;
    private string? _editCategory;
    private string? _editModel;
    private decimal? _editValuation;

    private Guid? _expandedId;
    private PhysicalAssetDetail? _detail;
    private string? _detailError;
    private bool _isRevaluing;
    private string? _revalueError;
    private string? _revalueRawResponse;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        try
        {
            _assets = (await AssetRepository.GetAllAsync()).ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load inventory: {ex.Message}";
        }
    }

    private async Task ToggleExpandAsync(Guid id)
    {
        if (_expandedId == id)
        {
            _expandedId = null;
            _detail = null;
            _detailError = null;
            return;
        }

        _expandedId = id;
        _detail = null;
        _detailError = null;
        _revalueError = null;

        try
        {
            _detail = await AssetRepository.GetByIdAsync(id);
            if (_detail is null)
            {
                _detailError = "This item could not be found.";
            }
        }
        catch (Exception ex)
        {
            _detailError = $"Failed to load item: {ex.Message}";
        }
    }

    // #237: mirrors the scan-possession flow's valuation behavior - the user
    // never types a price, it's always estimated the same way a scanned
    // item's is (PA10's Revalue uses the identical ValuationService call).
    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(_newName))
        {
            return;
        }

        _errorMessage = null;
        _errorRawResponse = null;
        _isAdding = true;

        try
        {
            var id = await AssetRepository.AddAsync(new PhysicalAssetInput(_newName, _newCategory, _newModel, InitialValuation: null));

            try
            {
                var valuation = await ValuationService.EstimateAsync(_newName, brand: null, _newModel);

                if (valuation.EstimatedValueUsd is { } value)
                {
                    await AssetRepository.AddValuationAsync(id, value, valuation.SourceLabel, valuation.Reasoning, valuation.Evidence);
                }
                else
                {
                    _errorMessage = $"Item added, but its value could not be estimated: {valuation.Reasoning}";
                }
            }
            catch (AssetValuationException ex)
            {
                _errorMessage = $"Item added, but its value could not be estimated: {ex.Message}";
                _errorRawResponse = ex.RawResponse;
            }

            _newName = string.Empty;
            _newCategory = null;
            _newModel = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to add item: {ex.Message}";
        }
        finally
        {
            _isAdding = false;
        }
    }

    private void BeginEdit(PhysicalAssetSummary asset)
    {
        _expandedId = null;
        _detail = null;
        _editingId = asset.Id;
        _editName = asset.Name;
        _editCategory = asset.Category;
        _editModel = asset.IdentifiedProductModel;
        _editValuation = null;
    }

    private void CancelEdit() => _editingId = null;

    private async Task SaveEditAsync()
    {
        if (_editingId is not { } id)
        {
            return;
        }

        _errorMessage = null;
        try
        {
            await AssetRepository.UpdateAsync(id, new PhysicalAssetInput(_editName, _editCategory, _editModel, _editValuation));
            _editingId = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to save changes: {ex.Message}";
        }
    }

    private async Task DeleteAsync(Guid id)
    {
        _errorMessage = null;
        try
        {
            await AssetRepository.DeleteAsync(id);
            if (_expandedId == id)
            {
                _expandedId = null;
                _detail = null;
            }

            await LoadAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to delete item: {ex.Message}";
        }
    }

    // PA10.1/PA10.2: re-runs the market valuation pipeline for this item's
    // existing identification and appends the
    // result as a new history entry - it never overwrites prior valuations.
    private async Task RevalueAsync()
    {
        if (_detail is null || _expandedId is not { } id)
        {
            return;
        }

        _revalueError = null;
        _revalueRawResponse = null;
        _isRevaluing = true;

        try
        {
            var valuation = await ValuationService.EstimateAsync(_detail.Name, brand: null, _detail.IdentifiedProductModel);

            if (valuation.EstimatedValueUsd is not { } value)
            {
                _revalueError = valuation.Reasoning;
                return;
            }

            var updated = await AssetRepository.AddValuationAsync(
                id,
                value,
                valuation.SourceLabel,
                valuation.Reasoning,
                valuation.Evidence);

            if (!updated)
            {
                _revalueError = "This item could not be found.";
                return;
            }

            _detail = await AssetRepository.GetByIdAsync(id);
            await LoadAsync();
        }
        catch (AssetValuationException ex)
        {
            _revalueError = ex.Message;
            _revalueRawResponse = ex.RawResponse;
        }
        finally
        {
            _isRevaluing = false;
        }
    }

    // Purely cosmetic: picks a recognizable glyph for the row's icon badge
    // from the free-text category. Falls back to a generic box for anything
    // that doesn't match a known bucket - never blocks on an unrecognized
    // category.
    private static string CategoryIconKey(string? category)
    {
        if (string.IsNullOrWhiteSpace(category))
        {
            return "box";
        }

        var c = category.ToLowerInvariant();
        if (c.Contains("electronic") || c.Contains("tech") || c.Contains("computer") || c.Contains("phone") || c.Contains("device"))
        {
            return "device";
        }
        if (c.Contains("kitchen") || c.Contains("housewares") || c.Contains("home"))
        {
            return "mug";
        }
        if (c.Contains("pantry") || c.Contains("food") || c.Contains("grocery") || c.Contains("snack"))
        {
            return "bag";
        }
        if (c.Contains("furniture"))
        {
            return "chair";
        }
        if (c.Contains("cloth") || c.Contains("apparel") || c.Contains("wear"))
        {
            return "shirt";
        }

        return "box";
    }

    // The SVG markup is a fixed constant per icon key - never built from the
    // category text itself - so this stays safe to render unescaped.
    private static MarkupString CategoryIconMarkup(string? category) => new(CategoryIconKey(category) switch
    {
        "device" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="7" y="2" width="10" height="20" rx="2"/><line x1="11" y1="18" x2="13" y2="18"/></svg>""",
        "mug" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h11v9a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V4z"/><path d="M15 7h2a3 3 0 0 1 0 6h-2"/></svg>""",
        "bag" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 3l1 4-2 2 1 12h12l1-12-2-2 1-4z"/></svg>""",
        "chair" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 4v9a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4"/><path d="M7 15v5M17 15v5"/><path d="M6 9h12"/></svg>""",
        "shirt" => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 3l4 2 4-2 4 4-3 3v11H7V10L4 7z"/></svg>""",
        _ => """<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 8l-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 3v10"/></svg>"""
    });
}
