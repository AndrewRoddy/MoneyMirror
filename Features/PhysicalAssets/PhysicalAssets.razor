@page "/physical-assets"
@rendermode InteractiveServer
@using Microsoft.Extensions.Options
@using MoneyMirror.PhysicalAssets
@inject IImageUploadValidator UploadValidator
@inject IPossessionImageStorage ImageStorage
@inject IPhysicalAssetDetectionService DetectionService
@inject IAssetValuationService ValuationService
@inject IPhysicalAssetRepository AssetRepository
@inject IOptions<ImageUploadOptions> UploadOptions

<PageTitle>Physical Assets</PageTitle>

<div class="standard-page">
    <header class="page-header">
        <div>
            <h1>Physical Assets</h1>
            <p class="page-subtitle">Scan a photo or short video to identify and value your possessions.</p>
        </div>
    </header>

    <section class="page-card">
        <h2 class="page-section-title">Scan a possession</h2>
        <InputFile OnChange="OnFileSelectedAsync" accept="image/*" capture="environment" disabled="@(IsWorking || _videoBusy)" />
    </section>

    <VideoScanPicker Disabled="@IsWorking" OnSelected="ReviewVideoItems" BusyChanged="@(busy => _videoBusy = busy)" />

@if (_isProcessing)
{
    <div class="alert alert-info" role="status" aria-live="polite">
        <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
        <em>@_processingMessage</em>
    </div>
}

@if (_errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}

@if (_imageReference is not null)
{
    <p>Uploaded:</p>
    <img src="@($"/api/possession-images/{_imageReference}")" alt="Uploaded possession photo" style="max-width: 400px;" />
}

@if (_detections is not null)
{
    @if (_detections.Count == 0)
    {
        <p><em>No objects detected in this photo.</em></p>
    }
    else
    {
        <h2>Review Detected Items</h2>
        <p>Confirm, correct, or discard each detection below.</p>

        <div class="row g-2 mb-3" aria-label="Detection filters and sorting">
            <div class="col-sm-4">
                <label for="detection-category-filter" class="form-label">Category</label>
                <select id="detection-category-filter" class="form-select" @bind="_categoryFilter">
                    <option value="all">All categories</option>
                    @foreach (var category in CategoryOptions)
                    {
                        <option value="@category">@category</option>
                    }
                </select>
            </div>
            <div class="col-sm-4">
                <label for="detection-confidence-filter" class="form-label">Confidence</label>
                <select id="detection-confidence-filter" class="form-select" @bind="_confidenceFilter">
                    <option value="all">Any confidence</option>
                    <option value="high">High (80% or higher)</option>
                    <option value="medium">Medium (60% to 79%)</option>
                    <option value="low">Low (below 60%)</option>
                </select>
            </div>
            <div class="col-sm-4">
                <label for="detection-sort" class="form-label">Sort by</label>
                <select id="detection-sort" class="form-select" @bind="_sortOrder">
                    <option value="confidence-desc">Confidence (high to low)</option>
                    <option value="confidence-asc">Confidence (low to high)</option>
                    <option value="category-asc">Category (A to Z)</option>
                </select>
            </div>
        </div>

        <p class="text-muted" aria-live="polite">
            Showing @FilteredDetections.Count of @_detections.Count detections.
        </p>

        <div class="d-flex flex-wrap gap-2 align-items-center mb-3" aria-label="Bulk detection actions">
            <button type="button" class="btn btn-outline-success" @onclick="AcceptHighConfidence">
                Accept all high-confidence
            </button>
            <button type="button" class="btn btn-outline-danger" @onclick="DiscardLowConfidence">
                Discard all low-confidence
            </button>
            <span class="text-muted small">Bulk actions apply to all items in this review.</span>
        </div>

        @foreach (var detection in FilteredDetections)
        {
            var detectionIndex = DetectionIndex(detection);
            <div class="border rounded p-3 mb-2 @(detection.Included ? "" : "opacity-50")">
                @if (detection.ImageReference is not null)
                {
                    <img src="@($"/api/possession-images/{detection.ImageReference}")" alt="Selected @detection.Original.Label from video"
                         style="max-width: 240px; max-height: 180px;" class="mb-2" />
                }
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="include-@detectionIndex" @bind="detection.Included" />
                    <label class="form-check-label" for="include-@detectionIndex">
                        <strong>@detection.Original.Label</strong>
                        (@((detection.Original.Confidence * 100).ToString("F0"))% confidence)
                        @if (detection.IsLowConfidence)
                        {
                            <span class="badge bg-warning text-dark">Needs review</span>
                        }
                    </label>
                </div>

                @if (detection.Original.Tags.Count > 0)
                {
                    <div class="mt-2" aria-label="Detected tags">
                        @foreach (var tag in detection.Original.Tags)
                        {
                            <span class="badge bg-light text-dark border me-1">@tag</span>
                        }
                    </div>
                }

                @if (detection.Included)
                {
                    <div class="row mt-2">
                        <div class="col">
                            <label for="brand-@detectionIndex" class="form-label">Brand</label>
                            <input id="brand-@detectionIndex" class="form-control" placeholder="Unknown" @bind="detection.Brand" />
                        </div>
                        <div class="col">
                            <label for="model-@detectionIndex" class="form-label">Model</label>
                            <input id="model-@detectionIndex" class="form-control" placeholder="Unknown" @bind="detection.Model" />
                        </div>
                    </div>

                    <button class="btn btn-outline-secondary btn-sm mt-2" @onclick="() => EstimateValueAsync(detection)" disabled="@(IsWorking || _videoBusy || detection.SavedItemId is not null)">
                        @(detection.IsEstimating ? "Estimating value with AI..." : "Estimate value")
                    </button>

                    @if (detection.ValuationError is not null)
                    {
                        <div class="alert alert-danger mt-2 mb-0 py-1" role="alert">@detection.ValuationError</div>
                    }

                    @if (detection.Valuation is not null)
                    {
                        <div class="mt-2">
                            <span class="fw-bold">$@detection.Valuation.EstimatedValueUsd.ToString("N2")</span>
                            <span class="badge bg-secondary">AI estimate - not based on live market data</span>
                            <p class="text-muted mb-0">@detection.Valuation.Reasoning</p>
                        </div>

                        @if (detection.SavedItemId is { } savedId)
                        {
                            <div class="alert alert-success mt-2 mb-0 py-1" role="alert">
                                @(detection.WasMerged ? "Merged into existing item." : "Saved to inventory.")
                                <a href="/inventory">View in inventory</a>
                            </div>
                        }
                        else
                        {
                            @if (detection.PossibleDuplicates.Count > 0)
                            {
                                <div class="alert alert-warning mt-2 mb-2 py-2" role="alert">
                                    <p class="mb-1">This looks similar to what's already in your inventory. You can save it as a new item, or merge this valuation into an existing one:</p>
                                    @foreach (var duplicate in detection.PossibleDuplicates)
                                    {
                                        <button
                                            type="button"
                                            class="btn btn-outline-warning btn-sm me-2 mb-1"
                                            @onclick="() => SaveToInventoryAsync(detection, mergeIntoId: duplicate.Id)"
                                            disabled="@(IsWorking || _videoBusy)">
                                            Merge into "@duplicate.Name"
                                        </button>
                                    }
                                </div>
                            }

                            <button
                                class="btn btn-success btn-sm mt-2"
                                @onclick="() => SaveToInventoryAsync(detection, mergeIntoId: null)"
                                disabled="@(IsWorking || _videoBusy)">
                                @(detection.IsSaving ? "Saving..." : "Save as new item")
                            </button>

                            @if (detection.SaveError is not null)
                            {
                                <div class="alert alert-danger mt-2 mb-0 py-1" role="alert">@detection.SaveError</div>
                            }
                        }
                    }
                }
                else
                {
                    <p class="mb-0"><em>Discarded - not a real item.</em></p>
                }
            </div>
        }
    }
}

</div>

@code {
    private const double LowConfidenceThreshold = 0.6;
    private const double HighConfidenceThreshold = 0.8;

    private bool _isProcessing;
    private bool _videoBusy;
    private bool IsWorking => _isProcessing || (_detections?.Any(d => d.IsSaving || d.IsEstimating) ?? false);
    private string? _processingMessage;
    private string? _errorMessage;
    private string? _fileName;
    private string? _imageReference;
    private List<ReviewableDetection>? _detections;
    private string _categoryFilter = "all";
    private string _confidenceFilter = "all";
    private string _sortOrder = "confidence-desc";

    private void ReviewVideoItems(IReadOnlyList<SelectedVideoAsset> items)
    {
        _errorMessage = null;
        _imageReference = null;
        _categoryFilter = _confidenceFilter = "all";
        _sortOrder = "confidence-desc";
        _detections = items.Select(item => new ReviewableDetection(item.Detection) { ImageReference = item.ImageReference }).ToList();
    }

    private IReadOnlyList<string> CategoryOptions => _detections is null
        ? Array.Empty<string>()
        : _detections
            .Select(detection => detection.Original.Label)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(category => category, StringComparer.OrdinalIgnoreCase)
            .ToList();

    private IReadOnlyList<ReviewableDetection> FilteredDetections
    {
        get
        {
            if (_detections is null)
            {
                return Array.Empty<ReviewableDetection>();
            }

            IEnumerable<ReviewableDetection> filtered = _detections;

            if (!string.Equals(_categoryFilter, "all", StringComparison.OrdinalIgnoreCase))
            {
                filtered = filtered.Where(detection =>
                    string.Equals(detection.Original.Label, _categoryFilter, StringComparison.OrdinalIgnoreCase));
            }

            filtered = _confidenceFilter switch
            {
                "high" => filtered.Where(detection => detection.Original.Confidence >= 0.8),
                "medium" => filtered.Where(detection => detection.Original.Confidence >= LowConfidenceThreshold && detection.Original.Confidence < 0.8),
                "low" => filtered.Where(detection => detection.Original.Confidence < LowConfidenceThreshold),
                _ => filtered
            };

            return _sortOrder switch
            {
                "confidence-asc" => filtered.OrderBy(detection => detection.Original.Confidence).ToList(),
                "category-asc" => filtered
                    .OrderBy(detection => detection.Original.Label, StringComparer.OrdinalIgnoreCase)
                    .ThenByDescending(detection => detection.Original.Confidence)
                    .ToList(),
                _ => filtered.OrderByDescending(detection => detection.Original.Confidence).ToList()
            };
        }
    }

    private int DetectionIndex(ReviewableDetection detection) => _detections?.IndexOf(detection) ?? 0;

    private void AcceptHighConfidence()
    {
        if (_detections is null)
        {
            return;
        }

        foreach (var detection in _detections.Where(detection => detection.IsHighConfidence))
        {
            detection.Included = true;
        }
    }

    private void DiscardLowConfidence()
    {
        if (_detections is null)
        {
            return;
        }

        foreach (var detection in _detections.Where(detection => detection.IsLowConfidence))
        {
            detection.Included = false;
        }
    }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        if (IsWorking || _videoBusy) return;
        _errorMessage = null;
        _imageReference = null;
        _detections = null;
        _processingMessage = null;
        _categoryFilter = "all";
        _confidenceFilter = "all";
        _sortOrder = "confidence-desc";

        var file = e.File;
        _fileName = file.Name;

        var validation = UploadValidator.Validate(file.Name, file.Size);
        if (!validation.IsValid)
        {
            _errorMessage = validation.Error;
            return;
        }

        _isProcessing = true;
        _processingMessage = $"Reading {_fileName}...";
        StateHasChanged();

        try
        {
            byte[] bytes;
            await using (var stream = file.OpenReadStream(UploadOptions.Value.MaxFileSizeBytes))
            {
                using var buffer = new MemoryStream();
                await stream.CopyToAsync(buffer);
                bytes = buffer.ToArray();
            }

            _processingMessage = "Saving the uploaded photo...";
            StateHasChanged();
            using (var saveStream = new MemoryStream(bytes))
            {
                _imageReference = await ImageStorage.SaveAsync(saveStream, file.Name);
            }

            _processingMessage = "Detecting objects with AI...";
            StateHasChanged();
            var mediaType = PossessionImageContentType.FromFileName(file.Name);
            var detected = await DetectionService.DetectAsync(bytes, mediaType);
            _detections = detected.Select(d => new ReviewableDetection(d)).ToList();
        }
        catch (PossessionImageStorageException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (AssetDetectionException ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isProcessing = false;
            _processingMessage = null;
        }
    }

    private async Task EstimateValueAsync(ReviewableDetection detection)
    {
        if (IsWorking || _videoBusy || detection.SavedItemId is not null) return;
        detection.ValuationError = null;
        detection.IsEstimating = true;
        StateHasChanged();

        try
        {
            detection.Valuation = await ValuationService.EstimateAsync(
                detection.Original.Label,
                string.IsNullOrWhiteSpace(detection.Brand) ? null : detection.Brand,
                string.IsNullOrWhiteSpace(detection.Model) ? null : detection.Model);

            detection.PossibleDuplicates = await AssetRepository.FindPossibleDuplicatesAsync(
                detection.Original.Label,
                IdentifiedProductModelOf(detection));
        }
        catch (AssetValuationException ex)
        {
            detection.ValuationError = ex.Message;
        }
        finally
        {
            detection.IsEstimating = false;
        }
    }

    private static string? IdentifiedProductModelOf(ReviewableDetection detection)
    {
        var brand = string.IsNullOrWhiteSpace(detection.Brand) ? null : detection.Brand;
        var model = string.IsNullOrWhiteSpace(detection.Model) ? null : detection.Model;
        return brand is not null || model is not null ? $"{brand} {model}".Trim() : null;
    }

    // PA8: a duplicate warning never blocks saving - the caller can always
    // save as a new item (mergeIntoId: null) even when possible duplicates
    // were found.
    private async Task SaveToInventoryAsync(ReviewableDetection detection, Guid? mergeIntoId)
    {
        if (detection.Valuation is null || IsWorking || _videoBusy || detection.SavedItemId is not null)
        {
            return;
        }

        detection.SaveError = null;
        detection.IsSaving = true;
        StateHasChanged();

        try
        {
            if (mergeIntoId is { } existingId)
            {
                var merged = await AssetRepository.AddValuationAsync(
                    existingId,
                    detection.Valuation.EstimatedValueUsd,
                    "AI estimate (not evidence-based - see #148)",
                    detection.Valuation.Reasoning);

                if (!merged)
                {
                    detection.SaveError = "That existing item could not be found - it may have been deleted.";
                    return;
                }

                detection.SavedItemId = existingId;
                detection.WasMerged = true;
            }
            else
            {
                detection.SavedItemId = await AssetRepository.AddFromScanAsync(
                    new ScannedAssetInput(
                        detection.Original.Label,
                        Category: null,
                        IdentifiedProductModelOf(detection),
                        detection.ImageReference ?? _imageReference,
                        detection.Valuation.EstimatedValueUsd,
                        detection.Valuation.Reasoning));
            }
        }
        catch (Exception ex)
        {
            detection.SaveError = $"Failed to save to inventory: {ex.Message}";
        }
        finally
        {
            detection.IsSaving = false;
        }
    }

    /// <summary>
    /// In-memory review state for one DetectedAsset: whether the user is
    /// keeping it, any brand/model correction, an optional AI-estimated
    /// valuation (#138), and (#72-74) whether/where it's been saved to the
    /// inventory. This is the seam between PA3's detection output and
    /// PA7's save step.
    /// </summary>
    private class ReviewableDetection(DetectedAsset original)
    {
        public DetectedAsset Original { get; } = original;
        public string? ImageReference { get; init; }
        public bool Included { get; set; } = true;
        public string Brand { get; set; } = original.Identification?.Brand ?? string.Empty;
        public string Model { get; set; } = original.Identification?.Model ?? string.Empty;
        public bool IsEstimating { get; set; }
        public AssetValuation? Valuation { get; set; }
        public string? ValuationError { get; set; }
        public bool IsSaving { get; set; }
        public string? SaveError { get; set; }
        public Guid? SavedItemId { get; set; }
        public bool WasMerged { get; set; }
        public IReadOnlyList<PhysicalAssetSummary> PossibleDuplicates { get; set; } = [];

        public bool IsHighConfidence =>
            Original.Confidence >= HighConfidenceThreshold
            && (Original.Identification is null || Original.Identification.Confidence >= HighConfidenceThreshold);

        public bool IsLowConfidence =>
            Original.Confidence < LowConfidenceThreshold
            || (Original.Identification is not null && Original.Identification.Confidence < LowConfidenceThreshold);
    }
}
