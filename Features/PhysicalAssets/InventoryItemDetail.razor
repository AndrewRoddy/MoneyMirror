@page "/inventory/{Id:guid}"
@rendermode InteractiveServer
@using MoneyMirror.PhysicalAssets
@inject IPhysicalAssetRepository AssetRepository
@inject IAssetValuationService ValuationService

<PageTitle>@(_asset?.Name ?? "Inventory Item")</PageTitle>

<div class="standard-page">
@if (_errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}

@if (_asset is null)
{
    @if (_errorMessage is null)
    {
        <p><em>Loading...</em></p>
    }
}
else
{
    <header class="page-header">
        <div>
            <div class="page-eyebrow">PHYSICAL CAPITAL / INVENTORY</div>
            <h1>@_asset.Name</h1>
        </div>
        <a class="secondary-button" href="/inventory">&larr; Back to inventory</a>
    </header>

    @if (_asset.ImageReference is not null)
    {
        <img
            src="@($"/api/possession-images/{_asset.ImageReference}")"
            alt="@_asset.Name"
            style="max-width: 400px;"
            class="mb-3 d-block" />
    }

    <section class="page-card">
    <dl class="row mb-0">
        <dt class="col-sm-3">Category</dt>
        <dd class="col-sm-9">@(_asset.Category ?? "—")</dd>

        <dt class="col-sm-3">Product/Model</dt>
        <dd class="col-sm-9">@(_asset.IdentifiedProductModel ?? "—")</dd>

        <dt class="col-sm-3">Source</dt>
        <dd class="col-sm-9">@(_asset.IsManuallyAdded ? "Manually added" : "Scanned")</dd>
    </dl>
    </section>

    <div class="d-flex align-items-center gap-2 mb-3">
        <button class="btn btn-outline-primary btn-sm" disabled="@_isRevaluing" @onclick="RevalueAsync">
            @(_isRevaluing ? "Revaluing..." : "Revalue")
        </button>
    </div>

    @if (_revalueError is not null)
    {
        <div class="alert alert-danger" role="alert">@_revalueError</div>
    }

    <section class="page-card">
    <h2 class="page-section-title">Valuation History</h2>
    @if (_asset.ValuationHistory.Count == 0)
    {
        <p><em>No valuations yet.</em></p>
    }
    else
    {
        <ul class="list-unstyled">
            @foreach (var entry in _asset.ValuationHistory)
            {
                <li class="border rounded p-3 mb-2">
                    <span class="fw-bold">$@entry.EstimatedValue.ToString("N2")</span>
                    <span class="text-muted">on @entry.ValuedAt.ToString("d")</span>
                    @if (entry.Source is not null)
                    {
                        <span class="badge bg-secondary">@entry.Source</span>
                    }
                    @if (entry.Notes is not null)
                    {
                        <p class="mb-0 mt-1">@entry.Notes</p>
                    }
                </li>
            }
        </ul>
    }
    </section>
}
</div>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private PhysicalAssetDetail? _asset;
    private string? _errorMessage;
    private bool _isRevaluing;
    private string? _revalueError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _asset = await AssetRepository.GetByIdAsync(Id);
            if (_asset is null)
            {
                _errorMessage = "This item could not be found.";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load item: {ex.Message}";
        }
    }

    // PA10.1/PA10.2: re-runs the (currently AI-estimated, see #138) valuation
    // pipeline for this item's existing identification and appends the
    // result as a new history entry - it never overwrites prior valuations.
    private async Task RevalueAsync()
    {
        if (_asset is null)
        {
            return;
        }

        _revalueError = null;
        _isRevaluing = true;
        StateHasChanged();

        try
        {
            var valuation = await ValuationService.EstimateAsync(_asset.Name, brand: null, _asset.IdentifiedProductModel);

            var updated = await AssetRepository.AddValuationAsync(
                Id,
                valuation.EstimatedValueUsd,
                "AI estimate (not evidence-based - see #148)",
                valuation.Reasoning);

            if (!updated)
            {
                _revalueError = "This item could not be found.";
                return;
            }

            _asset = await AssetRepository.GetByIdAsync(Id);
        }
        catch (AssetValuationException ex)
        {
            _revalueError = ex.Message;
        }
        finally
        {
            _isRevaluing = false;
        }
    }
}
