@page "/financials"
@page "/net-worth"
@attribute [StreamRendering(true)]
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using MoneyMirror.Data
@using MoneyMirror.Data.Entities
@using MoneyMirror.Financial
@using MoneyMirror.HumanCapital
@using MoneyMirror.PhysicalAssets
@inject MoneyMirrorDbContext DbContext
@inject IPhysicalAssetRepository AssetRepository
@inject IMarketPotentialSummaryService MarketPotentialSummaryService

<PageTitle>Net Worth</PageTitle>

<div class="finance-page">
    <header class="finance-header">
        <div>
            <h1>Financial</h1>
        </div>
        <div class="header-actions">
            <button class="secondary-button" @onclick="() => OpenAddForm(RecordKind.Asset)">
                <span>+</span> Add asset
            </button>
            <button class="primary-button" @onclick="() => OpenAddForm(RecordKind.Liability)">
                <span>+</span> Add liability
            </button>
        </div>
    </header>

    @if (IsLoading)
    {
        <div class="alert alert-info" role="status">Loading your financial records...</div>
    }

    @if (ErrorMessage is not null)
    {
        <div class="alert alert-danger" role="alert">@ErrorMessage</div>
    }

    <section class="net-worth-summary" aria-label="Net worth summary">
        <div class="headline-figure">
            <dt>Net Worth</dt>
            <strong class="headline-amount">@NetWorth.ToString("C0")</strong>
            <p class="headline-note">Financial assets + physical capital - liabilities</p>
        </div>

        <dl class="breakdown-row">
            <div class="breakdown-item">
                <dt>Financial assets</dt>
                <dd>@TotalFinancialAssets.ToString("C0")</dd>
            </div>
            <div class="breakdown-item">
                <dt>Physical capital</dt>
                <dd>@TotalPhysicalCapital.ToString("C0")</dd>
            </div>
            <div class="breakdown-item breakdown-liability">
                <dt>Total liabilities</dt>
                <dd>@TotalLiabilities.ToString("C0")</dd>
            </div>
        </dl>
    </section>

    @*
        Market potential used to live on the Dashboard, which is now the
        landing page. It belongs here, beside the total rather than inside
        it: earning power is real but it is not cash, so folding it into
        the figure above would make that figure a lie.
    *@
    <section class="potential-summary" aria-label="Market potential">
        <div class="potential-head">
            <p class="potential-label">Market potential</p>
            <a href="/market-potential">Details &rarr;</a>
        </div>

        @if (IsLoadingPotential)
        {
            <p class="potential-pending"><em>Estimating...</em></p>
        }
        else if (PotentialError is not null)
        {
            <p class="potential-pending">@PotentialError</p>
        }
        else if (!HasProfile)
        {
            <p class="potential-pending">
                No profile on file yet. <a href="/human-capital">Upload a resume</a> to see
                what the market pays for what you already know.
            </p>
        }
        else if (Compensation is null)
        {
            <p class="potential-pending">Not available for this profile.</p>
        }
        else
        {
            <strong class="potential-amount">
                $@Compensation.MinUsd.ToString("N0") &ndash; $@Compensation.MaxUsd.ToString("N0")
            </strong>
            <p class="potential-note">
                <span class="badge bg-secondary">AI estimate</span>
                across @OccupationCount matched occupation@(OccupationCount == 1 ? "" : "s"). Kept
                out of the net worth above on purpose.
            </p>
        }
    </section>

    <div class="records-toolbar">
        <div class="record-tabs" role="tablist" aria-label="Record type">
            <button class="record-tab @(ActiveTab == RecordKind.All ? "selected" : "")" @onclick="() => ActiveTab = RecordKind.All">
                Everything 
                <span>
                    @(AssetRecords.Count + LiabilityRecords.Count)
                </span>
            </button>
            <button class="record-tab @(ActiveTab == RecordKind.Asset ? "selected" : "")" @onclick="() => ActiveTab = RecordKind.Asset">
                Assets 
                <span>
                    @AssetRecords.Count
                </span>
            </button>
            <button class="record-tab @(ActiveTab == RecordKind.Liability ? "selected" : "")" @onclick="() => ActiveTab = RecordKind.Liability">
                Liabilities 
                <span>
                    @LiabilityRecords.Count
                </span>
            </button>
        </div>
    </div>

    <section class="records-card">
        <div class="records-heading">
            <div><h2>@(ActiveTab == RecordKind.Liability ? "Your liabilities" : ActiveTab == RecordKind.Asset ? "Assets" : "Accounts")</h2></div>
            <div class="record-count">@VisibleRecords.Count @(VisibleRecords.Count == 1 ? "record" : "records")</div>
        </div>

        @if (VisibleRecords.Count == 0)
        {
            <div class="empty-records"><div class="empty-icon">＋</div><h3>Nothing here yet</h3><p>Add your first @(ActiveTab == RecordKind.Liability ? "liability" : "asset") to start building your snapshot.</p></div>
        }
        else
        {
            <div class="records-table-wrap">
                <table class="records-table">
                    <thead><tr><th>Type</th><th>Name</th><th>@(ActiveTab == RecordKind.Liability ? "Current balance" : "Current value")</th><th>As of</th><th><span class="sr-only">Actions</span></th></tr></thead>
                    <tbody>
                        @foreach (var record in VisibleRecords)
                        {
                            <tr @key="record.Id">
                                <td class="record-type"><span class="type-pill @(record.Kind == RecordKind.Asset ? "asset-pill" : "liability-pill")"><span></span>@record.Type</span></td>
                                <td class="record-name-cell"><div class="record-name"><strong>@record.Name</strong></div></td><td class="record-amount">@((record.Amount ?? 0m).ToString("C2"))</td>
                                <td class="record-date">@(record.AsOfDate?.ToString("MMM d, yyyy") ?? "—")</td>
                                <td class="record-actions"><button title="Edit @record.Name" aria-label="Edit @record.Name" @onclick="() => OpenEditForm(record)">Edit</button><button class="delete-action" title="Delete @record.Name" aria-label="Delete @record.Name" @onclick="() => DeleteRecord(record)">Delete</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @*
        The Dashboard's inventory panel, moved here: physical capital is a
        line in the breakdown above, and this is where you look when you
        want to know what is behind that line. Closed by default - the
        financial records are what this page is for.
    *@
    <section class="inventory-panel">
        @* Rendered as a string, not a bool: Blazor omits an attribute whose
           value is false, which would drop aria-expanded exactly when the
           panel is collapsed and leave the control unannounced. *@
        <button type="button" class="inventory-toggle" aria-expanded="@(ShowInventory ? "true" : "false")"
                aria-controls="financial-inventory" @onclick="() => ShowInventory = !ShowInventory">
            <span aria-hidden="true">@(ShowInventory ? "▾" : "▸")</span> Your inventory
        </button>
        @if (ShowInventory)
        {
            <div id="financial-inventory" class="inventory-body">
                <InventoryList ShowAddForm="false" />
                <a href="/inventory">Manage inventory &rarr;</a>
            </div>
        }
    </section>
</div>

@if (IsFormOpen)
{
    <div class="modal-backdrop" @onclick="CloseForm"></div>
    <aside class="record-drawer" aria-label="@(IsEditing ? "Edit record" : "Add record")">
        <div class="drawer-grabber" aria-hidden="true"></div>
        <div class="drawer-header"><div><div class="finance-eyebrow">@(IsEditing ? "UPDATE RECORD" : "NEW RECORD")</div><h2>@(IsEditing ? "Edit" : "Add") @(Draft.Kind == RecordKind.Asset ? "asset" : "liability")</h2></div><button class="close-drawer" aria-label="Close" @onclick="CloseForm">×</button></div>
        <p class="drawer-copy">@(Draft.Kind == RecordKind.Asset ? "Add an account or property you own." : "Add a balance or debt you currently owe.")</p>

        <EditForm Model="Draft" OnValidSubmit="SaveRecord" class="record-form">
            <DataAnnotationsValidator />
            <ValidationSummary class="form-summary" />
            <div class="form-field"><label for="record-type">Type</label><div class="select-field"><InputSelect id="record-type" @bind-Value="Draft.Type"><option value="">Select a type</option>@foreach (var type in TypesFor(Draft.Kind)) { <option value="@type">@type</option> }</InputSelect></div><ValidationMessage For="() => Draft.Type" /></div>
            <div class="form-field"><label for="record-name">Name</label><InputText id="record-name" @bind-Value="Draft.Name" placeholder="e.g. Chase checking" /><ValidationMessage For="() => Draft.Name" /></div>
            <div class="form-field"><label for="record-amount">@(Draft.Kind == RecordKind.Asset ? "Current value" : "Current balance")</label><div class="currency-field"><span>$</span><InputNumber id="record-amount" @bind-Value="Draft.Amount" min="0" step="0.01" placeholder="0.00" /></div><ValidationMessage For="() => Draft.Amount" /></div>
            <div class="form-field"><label for="record-date">As-of date</label><InputDate id="record-date" @bind-Value="Draft.AsOfDate" /><ValidationMessage For="() => Draft.AsOfDate" /></div>
            <div class="drawer-actions"><button type="button" class="secondary-button" @onclick="CloseForm">Cancel</button><button type="submit" class="primary-button">@(IsEditing ? "Save changes" : "Add record")</button></div>
        </EditForm>
    </aside>
}

@code {
    private readonly List<FinancialRecord> AssetRecords = [];
    private readonly List<FinancialRecord> LiabilityRecords = [];
    private IReadOnlyList<PhysicalAssetSummary> PhysicalAssets = [];

    private RecordKind ActiveTab { get; set; } = RecordKind.All;
    private bool IsFormOpen { get; set; }
    private bool IsEditing { get; set; }
    private bool IsLoading { get; set; } = true;
    private string? ErrorMessage { get; set; }

    private bool IsLoadingPotential { get; set; } = true;
    private string? PotentialError { get; set; }
    private bool HasProfile { get; set; }
    private CompensationEstimate? Compensation { get; set; }
    private int OccupationCount { get; set; }
    private bool ShowInventory { get; set; }
    private FinancialRecord Draft { get; set; } = NewDraft(RecordKind.Asset);
    private FinancialRecord? EditingRecord { get; set; }

    // FC2's formula extended per #75: financial assets + physical capital -
    // liabilities. Still purely deterministic - no AI participates here.
    private decimal NetWorth => FinancialNetWorthCalculator.Calculate(
        AssetRecords.Select(record => record.Amount ?? 0m)
            .Concat(PhysicalAssets.Select(asset => asset.CurrentValuation ?? 0m)),
        LiabilityRecords.Select(record => record.Amount ?? 0m));
    private decimal TotalFinancialAssets => AssetRecords.Sum(record => record.Amount ?? 0m);
    private decimal TotalPhysicalCapital => PhysicalAssets.Sum(asset => asset.CurrentValuation ?? 0m);
    private decimal TotalLiabilities => LiabilityRecords.Sum(record => record.Amount ?? 0m);
    private List<FinancialRecord> VisibleRecords => ActiveTab switch
    {
        RecordKind.Asset => AssetRecords,
        RecordKind.Liability => LiabilityRecords,
        _ => AssetRecords.Concat(LiabilityRecords).OrderByDescending(record => record.AsOfDate).ToList()
    };

    private static readonly Dictionary<RecordKind, string[]> RecordTypes = new()
    {
        [RecordKind.Asset] = new[] { "Cash", "Investments", "Property", "Vehicle", "Other asset" },
        [RecordKind.Liability] = new[] { "Mortgage", "Student loan", "Credit card", "Personal loan", "Other liability" }
    };

    private static string[] TypesFor(RecordKind kind) => RecordTypes[kind];
    private static FinancialRecord NewDraft(RecordKind kind) => new(kind, "", "", null, DateTime.Today);
    private static DateTimeOffset ToDateTimeOffset(DateTime date) =>
        new(DateTime.SpecifyKind(date.Date, DateTimeKind.Unspecified), TimeSpan.Zero);

    // The records and the market-potential estimate fail independently: a
    // provider outage must never take down the financial records, which are
    // the point of the page. They run sequentially rather than via
    // Task.WhenAll because both reach the same scoped DbContext (directly,
    // and via IPhysicalAssetRepository/IProfessionalProfileRepository),
    // which EF Core does not allow concurrent operations against.
    //
    // Records first, and [StreamRendering] on top: the estimate can take a
    // minute against a cold cache, and nobody should wait on Nemotron to see
    // their own balances.
    protected override async Task OnInitializedAsync()
    {
        await LoadRecordsAsync();
        await LoadMarketPotentialAsync();
    }

    private async Task LoadRecordsAsync()
    {
        try
        {
            var accounts = await DbContext.FinancialAccounts
                .AsNoTracking()
                .OrderByDescending(account => account.UpdatedAt)
                .ToListAsync();
            var liabilities = await DbContext.Liabilities
                .AsNoTracking()
                .OrderByDescending(liability => liability.UpdatedAt)
                .ToListAsync();

            AssetRecords.AddRange(accounts.Select(account => new FinancialRecord(
                account.Id,
                RecordKind.Asset,
                account.AccountType,
                account.Name,
                account.CurrentBalance,
                account.AsOfDate.LocalDateTime)));
            LiabilityRecords.AddRange(liabilities.Select(liability => new FinancialRecord(
                liability.Id,
                RecordKind.Liability,
                liability.LiabilityType,
                liability.Name,
                liability.OutstandingBalance,
                liability.AsOfDate.LocalDateTime)));

            PhysicalAssets = await AssetRepository.GetAllAsync();
        }
        catch (Exception)
        {
            ErrorMessage = "Financial records could not be loaded. Please try again.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task LoadMarketPotentialAsync()
    {
        try
        {
            var summary = await MarketPotentialSummaryService.GetSummaryAsync();
            HasProfile = summary.HasProfile;
            if (!HasProfile)
            {
                return;
            }

            OccupationCount = summary.Occupations.Count;
            Compensation = summary.Compensation;
        }
        catch (OccupationMatchingException ex)
        {
            PotentialError = ex.Message;
        }
        catch (CompensationEstimationException ex)
        {
            PotentialError = ex.Message;
        }
        finally
        {
            IsLoadingPotential = false;
        }
    }

    private void OpenAddForm(RecordKind kind) { IsEditing = false; EditingRecord = null; Draft = NewDraft(kind); IsFormOpen = true; }
    private void OpenEditForm(FinancialRecord record) { IsEditing = true; EditingRecord = record; Draft = new(record.Kind, record.Type, record.Name, record.Amount, record.AsOfDate); IsFormOpen = true; }
    private void CloseForm() { IsFormOpen = false; }
    private async Task SaveRecord()
    {
        ErrorMessage = null;

        try
        {
            var asOfDate = Draft.AsOfDate ?? DateTime.Today;
            var amount = Draft.Amount ?? 0m;

            if (IsEditing && EditingRecord is not null)
            {
                if (Draft.Kind == RecordKind.Asset)
                {
                    var account = await DbContext.FinancialAccounts.FindAsync(EditingRecord.Id)
                        ?? throw new InvalidOperationException("The financial account no longer exists.");
                    account.AccountType = Draft.Type;
                    account.Name = Draft.Name;
                    account.CurrentBalance = amount;
                    account.AsOfDate = ToDateTimeOffset(asOfDate);
                    account.UpdatedAt = DateTimeOffset.UtcNow;
                }
                else
                {
                    var liability = await DbContext.Liabilities.FindAsync(EditingRecord.Id)
                        ?? throw new InvalidOperationException("The liability no longer exists.");
                    liability.LiabilityType = Draft.Type;
                    liability.Name = Draft.Name;
                    liability.OutstandingBalance = amount;
                    liability.AsOfDate = ToDateTimeOffset(asOfDate);
                    liability.UpdatedAt = DateTimeOffset.UtcNow;
                }

                await DbContext.SaveChangesAsync();
                EditingRecord.Type = Draft.Type;
                EditingRecord.Name = Draft.Name;
                EditingRecord.Amount = Draft.Amount;
                EditingRecord.AsOfDate = Draft.AsOfDate;
            }
            else if (Draft.Kind == RecordKind.Asset)
            {
                DbContext.FinancialAccounts.Add(new FinancialAccount
                {
                    Id = Draft.Id,
                    AccountType = Draft.Type,
                    Name = Draft.Name,
                    CurrentBalance = amount,
                    AsOfDate = ToDateTimeOffset(asOfDate),
                    UpdatedAt = DateTimeOffset.UtcNow
                });
                await DbContext.SaveChangesAsync();
                AssetRecords.Add(Draft.ToRecord());
            }
            else
            {
                DbContext.Liabilities.Add(new Liability
                {
                    Id = Draft.Id,
                    LiabilityType = Draft.Type,
                    Name = Draft.Name,
                    OutstandingBalance = amount,
                    AsOfDate = ToDateTimeOffset(asOfDate),
                    UpdatedAt = DateTimeOffset.UtcNow
                });
                await DbContext.SaveChangesAsync();
                LiabilityRecords.Add(Draft.ToRecord());
            }

            ActiveTab = Draft.Kind;
            IsFormOpen = false;
        }
        catch (Exception)
        {
            ErrorMessage = "Financial record could not be saved. Please try again.";
        }
    }

    private async Task DeleteRecord(FinancialRecord record)
    {
        ErrorMessage = null;

        try
        {
            if (record.Kind == RecordKind.Asset)
            {
                var account = await DbContext.FinancialAccounts.FindAsync(record.Id);
                if (account is not null)
                {
                    DbContext.FinancialAccounts.Remove(account);
                }
            }
            else
            {
                var liability = await DbContext.Liabilities.FindAsync(record.Id);
                if (liability is not null)
                {
                    DbContext.Liabilities.Remove(liability);
                }
            }

            await DbContext.SaveChangesAsync();
            (record.Kind == RecordKind.Asset ? AssetRecords : LiabilityRecords).Remove(record);
        }
        catch (Exception)
        {
            ErrorMessage = "Financial record could not be deleted. Please try again.";
        }
    }

    private enum RecordKind { All, Asset, Liability }

    private sealed class FinancialRecord
    {
        public FinancialRecord(RecordKind kind, string type, string name, decimal? amount, DateTime? asOfDate)
            : this(Guid.NewGuid(), kind, type, name, amount, asOfDate) { }

        public FinancialRecord(Guid id, RecordKind kind, string type, string name, decimal? amount, DateTime? asOfDate)
        {
            Id = id;
            Kind = kind;
            Type = type;
            Name = name;
            Amount = amount;
            AsOfDate = asOfDate;
        }

        public Guid Id { get; }
        public RecordKind Kind { get; }
        [Required(ErrorMessage = "Choose a type.")] public string Type { get; set; }
        [Required(ErrorMessage = "Enter a name.")] public string Name { get; set; }
        [Required(ErrorMessage = "Enter an amount.")] [Range(0, double.MaxValue, ErrorMessage = "Amount must be zero or more.")] public decimal? Amount { get; set; }
        [Required(ErrorMessage = "Choose an as-of date.")] public DateTime? AsOfDate { get; set; }

        public FinancialRecord ToRecord() => new(Id, Kind, Type, Name, Amount, AsOfDate);
    }
}
